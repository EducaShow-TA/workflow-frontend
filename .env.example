# URL base del API. Vacio = mismo origen (recomendado): en produccion Nginx sirve la SPA y /api;
# en `nuxt dev` el devProxy de nuxt.config.ts reenvia /api al backend en http://localhost:8080.
NUXT_PUBLIC_API_BASE=

# Modulos que todavia usan datos de prueba, separados por comas (periodos-matricula, secciones, competencias, logs).
# Vacio = todos los modulos llaman al backend.
NUXT_PUBLIC_DATOS_PRUEBA=
